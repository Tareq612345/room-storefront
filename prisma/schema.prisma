// ============================================================================
// ROOM — D2C E-Commerce & Dynamic Storefront Engine
// Multi-tenant (storeId) PostgreSQL Schema
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
  OWNER
}

enum StoryBlockLayout {
  FULL_BLEED
  SPLIT_LEFT
  SPLIT_RIGHT
  SPEC_GRID
  VIDEO_BANNER
}

enum BundlePricingType {
  FIXED_PRICE
  PERCENTAGE_DISCOUNT
  AMOUNT_DISCOUNT
}

enum PageSectionType {
  HERO_SLIDER
  UNIVERSE_QUICK_BAR
  TRENDING_CAROUSEL
  FEATURED_BUNDLES
  FLASH_DEALS
  CATEGORY_SPOTLIGHT
  BEST_SELLERS
  NEW_ARRIVALS
  CUSTOMER_SETUPS
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  ONLINE_CARD
  WALLET
  INSTAPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  COD_COLLECTED
}

enum OrderItemType {
  PRODUCT
  BUNDLE
}

enum LoyaltyTier {
  ROOKIE
  PRO
  ELITE
  LEGEND
}

enum AnalyticsEventType {
  PAGE_VIEW
  VIEW_UNIVERSE
  VIEW_PRODUCT
  VIEW_PACKAGE
  ADD_TO_BAG
  BEGIN_CHECKOUT
  APPLY_PROMO
  PURCHASE
}

enum PromoDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum DispatchStatus {
  PENDING_DISPATCH
  AWB_CREATED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
}

// ============================================================================
// 1. STORE CONFIG (Multi-Storefront & Zero-Code Theme Tokens)
// ============================================================================

model StoreConfig {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  domain             String?  @unique
  currency           String   @default("EGP")
  defaultAccentColor String   @default("#7C3AED")
  themeTokens        Json     @default("{}")
  whatsappNumber     String?
  supportEmail       String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users            User[]
  universes        Universe[]
  products         Product[]
  productVariants  ProductVariant[]
  storyBlocks      ProductStoryBlock[]
  bundles          Bundle[]
  bundleItems      BundleItem[]
  pageSections     PageSection[]
  shippingZones    ShippingZone[]
  orders               Order[]
  orderItems           OrderItem[]
  loyaltyAccounts      LoyaltyAccount[]
  adminInvites         AdminInvite[]
  promoCodes           PromoCode[]
  analyticsEvents      AnalyticsEvent[]
  analyticsSessions    AnalyticsSession[]
  paymentTransactions  PaymentTransaction[]
  shipmentDispatches   ShipmentDispatch[]
  supportTickets       SupportTicket[]
  notificationLogs     NotificationLog[]

  @@index([isActive])
  @@map("store_configs")
}

// ============================================================================
// 2. USERS & ADMIN INVITES (Owners, Admins, Username Login, 48h Single-Use Invites)
// ============================================================================

model User {
  id           String   @id @default(cuid())
  storeId      String
  email        String?
  username     String?
  phone        String?
  name         String
  avatarUrl    String?
  passwordHash String?
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store          StoreConfig     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders         Order[]
  loyaltyAccount LoyaltyAccount?
  sentInvites    AdminInvite[]   @relation("InvitedBy")
  supportTickets SupportTicket[]

  @@unique([storeId, email])
  @@unique([storeId, username])
  @@unique([storeId, phone])
  @@index([storeId, role])
  @@map("users")
}

model AdminInvite {
  id          String    @id @default(cuid())
  storeId     String
  email       String
  role        UserRole  @default(ADMIN)
  token       String    @unique
  invitedById String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  store     StoreConfig @relation(fields: [storeId], references: [id], onDelete: Cascade)
  invitedBy User?       @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([storeId, email])
  @@index([token])
  @@map("admin_invites")
}

// ============================================================================
// 3. UNIVERSES (Themed Categories with Dynamic Accent Colors)
// ============================================================================

model Universe {
  id          String   @id @default(cuid())
  storeId     String
  slug        String
  name        String
  tagline     String?
  description String?
  accentColor String   @default("#7C3AED")
  iconUrl     String?
  bannerUrl   String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store    StoreConfig @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]
  bundles  Bundle[]

  @@unique([storeId, slug])
  @@index([storeId, isActive, sortOrder])
  @@map("universes")
}

// ============================================================================
// 4. CATALOG (Products, Variants, Oraimo-Style A+ Story Blocks)
// ============================================================================

model Product {
  id             String   @id @default(cuid())
  storeId        String
  universeId     String
  slug           String
  name           String
  subtitle       String?
  description    String?
  basePrice      Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  thumbnailUrl   String
  images         String[] @default([])
  isFeatured     Boolean  @default(false)
  isNewArrival   Boolean  @default(false)
  isBestSeller   Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store       StoreConfig         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  universe    Universe            @relation(fields: [universeId], references: [id], onDelete: Restrict)
  variants    ProductVariant[]
  storyBlocks ProductStoryBlock[]
  bundleItems BundleItem[]
  orderItems  OrderItem[]

  @@unique([storeId, slug])
  @@index([storeId, universeId, isActive])
  @@index([storeId, isFeatured, isActive])
  @@index([storeId, isNewArrival, isActive])
  @@index([storeId, isBestSeller, isActive])
  @@map("products")
}

model ProductVariant {
  id             String   @id @default(cuid())
  storeId        String
  productId      String
  sku            String
  name           String
  size           String?
  colorName      String?
  colorHex       String?
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  stock          Int      @default(0)
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store       StoreConfig  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  bundleItems BundleItem[]
  orderItems  OrderItem[]

  @@unique([storeId, sku])
  @@index([storeId, productId, isActive])
  @@index([productId, stock])
  @@map("product_variants")
}

model ProductStoryBlock {
  id             String           @id @default(cuid())
  storeId        String
  productId      String
  sortOrder      Int              @default(0)
  layoutType     StoryBlockLayout @default(FULL_BLEED)
  eyebrow        String?
  title          String
  body           String?
  mediaUrl       String
  mobileMediaUrl String?
  ctaLabel       String?
  ctaUrl         String?
  metadata       Json             @default("{}")
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  store   StoreConfig @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId, productId, isActive, sortOrder])
  @@map("product_story_blocks")
}

// ============================================================================
// 5. BUNDLES / LOADOUTS
// ============================================================================

model Bundle {
  id              String            @id @default(cuid())
  storeId         String
  universeId      String?
  slug            String
  name            String
  tagline         String?
  description     String?
  thumbnailUrl    String
  bannerUrl       String?
  pricingType     BundlePricingType @default(FIXED_PRICE)
  fixedPrice      Decimal?          @db.Decimal(10, 2)
  discountPercent Int?
  discountAmount  Decimal?          @db.Decimal(10, 2)
  isFeatured      Boolean           @default(false)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  store      StoreConfig  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  universe   Universe?    @relation(fields: [universeId], references: [id], onDelete: SetNull)
  items      BundleItem[]
  orderItems OrderItem[]

  @@unique([storeId, slug])
  @@index([storeId, universeId, isActive])
  @@index([storeId, isFeatured, isActive])
  @@map("bundles")
}

model BundleItem {
  id         String  @id @default(cuid())
  storeId    String
  bundleId   String
  productId  String
  variantId  String?
  quantity   Int     @default(1)
  sortOrder  Int     @default(0)
  isRequired Boolean @default(true)

  store   StoreConfig     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  bundle  Bundle          @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([storeId, bundleId, sortOrder])
  @@index([productId])
  @@map("bundle_items")
}

// ============================================================================
// 6. DYNAMIC PAGE BUILDER
// ============================================================================

model PageSection {
  id        String          @id @default(cuid())
  storeId   String
  pageKey   String          @default("home")
  type      PageSectionType
  title     String?
  subtitle  String?
  sortOrder Int             @default(0)
  isVisible Boolean         @default(true)
  config    Json            @default("{}")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  store StoreConfig @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, pageKey, isVisible, sortOrder])
  @@map("page_sections")
}

// ============================================================================
// 7. SHIPPING ZONES (Cairo / New Cairo)
// ============================================================================

model ShippingZone {
  id                    String   @id @default(cuid())
  storeId               String
  name                  String
  city                  String   @default("Cairo")
  fee                   Decimal  @db.Decimal(10, 2)
  freeShippingThreshold Decimal? @db.Decimal(10, 2)
  estimatedDays         String   @default("1-2 Days")
  sortOrder             Int      @default(0)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  store              StoreConfig        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders             Order[]
  analyticsEvents    AnalyticsEvent[]
  shipmentDispatches ShipmentDispatch[]

  @@unique([storeId, name])
  @@index([storeId, isActive, sortOrder])
  @@map("shipping_zones")
}

// ============================================================================
// 8. ORDERS & CHECKOUT (COD + Online Payments)
// ============================================================================

model Order {
  id               String        @id @default(cuid())
  storeId          String
  orderNumber      String
  userId           String?
  shippingZoneId   String
  customerName     String
  customerPhone    String
  customerWhatsapp String?
  customerEmail    String?
  shippingAddress  String
  city             String        @default("Cairo")
  notes            String?
  status           OrderStatus   @default(PENDING)
  paymentMethod    PaymentMethod @default(COD)
  paymentStatus    PaymentStatus @default(PENDING)
  paymentReference String?
  subtotal         Decimal       @db.Decimal(10, 2)
  shippingFee      Decimal       @db.Decimal(10, 2)
  discountAmount   Decimal       @default(0) @db.Decimal(10, 2)
  total            Decimal       @db.Decimal(10, 2)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  store               StoreConfig          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  shippingZone        ShippingZone         @relation(fields: [shippingZoneId], references: [id], onDelete: Restrict)
  promoCode           PromoCode?           @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  promoCodeId         String?
  items               OrderItem[]
  analyticsEvents     AnalyticsEvent[]
  analyticsSessions   AnalyticsSession[]
  paymentTransactions PaymentTransaction[]
  shipmentDispatches  ShipmentDispatch[]
  supportTickets      SupportTicket[]
  notificationLogs    NotificationLog[]

  @@unique([storeId, orderNumber])
  @@index([storeId, status, createdAt])
  @@index([storeId, userId])
  @@index([storeId, customerPhone])
  @@map("orders")
}

model OrderItem {
  id              String        @id @default(cuid())
  storeId         String
  orderId         String
  itemType        OrderItemType @default(PRODUCT)
  productId       String?
  variantId       String?
  bundleId        String?
  titleSnapshot   String
  variantSnapshot String?
  unitPrice       Decimal       @db.Decimal(10, 2)
  quantity        Int
  lineTotal       Decimal       @db.Decimal(10, 2)

  store   StoreConfig     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  bundle  Bundle?         @relation(fields: [bundleId], references: [id], onDelete: SetNull)

  @@index([storeId, orderId])
  @@map("order_items")
}

// ============================================================================
// 9. LOYALTY & REWARDS (Placeholder Foundation)
// ============================================================================

model LoyaltyAccount {
  id             String      @id @default(cuid())
  storeId        String
  userId         String      @unique
  pointsBalance  Int         @default(0)
  lifetimePoints Int         @default(0)
  tier           LoyaltyTier @default(ROOKIE)
  referralCode   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  store StoreConfig @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, referralCode])
  @@index([storeId, tier])
  @@map("loyalty_accounts")
}

// ============================================================================
// 10. PROMO CODES & CHECKOUT FOUNDATION
// ============================================================================

model PromoCode {
  id               String            @id @default(cuid())
  storeId          String
  code             String
  discountType     PromoDiscountType @default(PERCENTAGE)
  value            Decimal           @db.Decimal(10, 2)
  minOrderSubtotal Decimal           @default(0) @db.Decimal(10, 2)
  maxUses          Int?
  usedCount        Int               @default(0)
  expiresAt        DateTime?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  store  StoreConfig @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([storeId, code])
  @@index([storeId, isActive])
  @@map("promo_codes")
}

// ============================================================================
// 11. ANALYTICS & CONVERSION FUNNEL FOUNDATION
// ============================================================================

model AnalyticsSession {
  id             String   @id @default(cuid())
  storeId        String
  sessionKey     String
  landingPath    String
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  deviceType     String   @default("desktop")
  hasAddedToBag  Boolean  @default(false)
  hasPurchased   Boolean  @default(false)
  convertedOrderId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store          StoreConfig      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  convertedOrder Order?           @relation(fields: [convertedOrderId], references: [id], onDelete: SetNull)
  events         AnalyticsEvent[]

  @@unique([storeId, sessionKey])
  @@index([storeId, createdAt])
  @@index([storeId, utmSource])
  @@map("analytics_sessions")
}

model AnalyticsEvent {
  id             String             @id @default(cuid())
  storeId        String
  sessionId      String?
  eventType      AnalyticsEventType
  path           String
  entityType     String?
  entityId       String?
  entitySlug     String?
  revenue        Decimal?           @db.Decimal(10, 2)
  utmSource      String?
  shippingZoneId String?
  orderId        String?
  metadata       Json               @default("{}")
  createdAt      DateTime           @default(now())

  store        StoreConfig       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  session      AnalyticsSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  shippingZone ShippingZone?     @relation(fields: [shippingZoneId], references: [id], onDelete: SetNull)
  order        Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([storeId, eventType, createdAt])
  @@index([storeId, entityId])
  @@index([orderId])
  @@map("analytics_events")
}

// ============================================================================
// 12. FUTURE OPERATIONS: PAYMENTS, DISPATCH, NOTIFICATIONS & SUPPORT
// ============================================================================

model PaymentTransaction {
  id                String        @id @default(cuid())
  storeId           String
  orderId           String
  method            PaymentMethod
  providerName      String        @default("manual-or-cod")
  providerReference String?
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  rawPayload        Json          @default("{}")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  store StoreConfig @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([storeId, orderId, status])
  @@map("payment_transactions")
}

model ShipmentDispatch {
  id             String         @id @default(cuid())
  storeId        String
  orderId        String
  shippingZoneId String
  courierName    String         @default("cairo-express-dispatch")
  trackingNumber String?
  dispatchStatus DispatchStatus @default(PENDING_DISPATCH)
  awbUrl         String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  store        StoreConfig  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shippingZone ShippingZone @relation(fields: [shippingZoneId], references: [id], onDelete: Restrict)

  @@index([storeId, orderId, dispatchStatus])
  @@map("shipment_dispatches")
}

model SupportTicket {
  id            String              @id @default(cuid())
  storeId       String
  ticketNumber  String
  orderId       String?
  userId        String?
  customerName  String
  customerPhone String
  channel       String              @default("whatsapp")
  subject       String
  status        SupportTicketStatus @default(OPEN)
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  store StoreConfig @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([storeId, ticketNumber])
  @@index([storeId, status, createdAt])
  @@map("support_tickets")
}

model NotificationLog {
  id          String   @id @default(cuid())
  storeId     String
  orderId     String?
  channel     String
  recipient   String
  templateKey String
  status      String   @default("QUEUED")
  payload     Json     @default("{}")
  createdAt   DateTime @default(now())

  store StoreConfig @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([storeId, orderId, createdAt])
  @@map("notification_logs")
}
